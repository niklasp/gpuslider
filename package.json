{
	"name": "shaderslide",
	"version": "0.0.1",
	"description": "A slider that draws its media on a WebGL canvas. Small core, everything else a plugin. No dependencies.",
	"type": "module",
	"license": "MIT",
	"sideEffects": [
		"*.css",
		"./src/auto.js",
		"./dist/auto.js"
	],
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/index.js"
		},
		"./full": {
			"types": "./types/full.d.ts",
			"default": "./src/full.js"
		},
		"./gl": {
			"types": "./types/gl/index.d.ts",
			"default": "./src/gl/index.js"
		},
		"./lightbox": {
			"types": "./types/lightbox.d.ts",
			"default": "./src/lightbox.js"
		},
		"./plugins": {
			"types": "./types/plugins/index.d.ts",
			"default": "./src/plugins/index.js"
		},
		"./react": {
			"types": "./types/react.d.ts",
			"default": "./src/react.js"
		},
		"./auto": {
			"types": "./types/auto.d.ts",
			"default": "./src/auto.js"
		},
		"./style.css": "./src/style.css",
		"./lightbox.css": "./src/lightbox.css"
	},
	"files": [
		"src",
		"types",
		"dist"
	],
	"scripts": {
		"start": "node bin/serve.mjs",
		"site": "npm install --prefix site --no-audit --no-fund && npm run dev --prefix site",
		"build": "node bin/build.mjs",
		"size": "node bin/build.mjs --check",
		"media": "node bin/make-media.mjs && node bin/make-variants.mjs",
		"test": "playwright test",
		"types": "rm -rf types && tsc -p tsconfig.json && tsc -p tests/types/tsconfig.json",
		"prepublishOnly": "npm run types && npm run size && npm test && npm run test:dist",
		"test:dist": "node bin/build.mjs && FROM=dist playwright test",
		"prepack": "node bin/build.mjs --check && npm run types"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/react": "^19.3.0",
		"esbuild": "^0.28.2",
		"react": "^19.3.0",
		"sharp": "^0.35.5",
		"typescript": "^7.0.2"
	},
	"types": "./types/index.d.ts",
	"unpkg": "./dist/auto.js",
	"jsdelivr": "./dist/auto.js",
	"peerDependencies": {
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}
