{
	"name": "shaderslide",
	"version": "0.0.1",
	"description": "A slider that draws its media on a WebGL canvas. Small core, everything else a plugin. No dependencies.",
	"type": "module",
	"license": "MIT",
	"sideEffects": [
		"*.css"
	],
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/index.js"
		},
		"./full": {
			"types": "./types/full.d.ts",
			"default": "./src/full.js"
		},
		"./gl": {
			"types": "./types/gl/index.d.ts",
			"default": "./src/gl/index.js"
		},
		"./lightbox": {
			"types": "./types/lightbox.d.ts",
			"default": "./src/lightbox.js"
		},
		"./plugins": {
			"types": "./types/plugins/index.d.ts",
			"default": "./src/plugins/index.js"
		},
		"./style.css": "./src/style.css"
	},
	"files": [
		"src",
		"types"
	],
	"scripts": {
		"start": "node bin/serve.mjs",
		"site": "npm install --prefix site --no-audit --no-fund && npm run dev --prefix site",
		"build": "node bin/build.mjs",
		"size": "node bin/build.mjs --check",
		"media": "node bin/make-media.mjs",
		"test": "playwright test",
		"types": "tsc -p tsconfig.json && tsc -p tests/types/tsconfig.json",
		"prepublishOnly": "npm run types && npm run size && npm test"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	},
	"types": "./types/index.d.ts"
}
