{
	"name": "gpuslider",
	"version": "1.0.5",
	"description": "A slider that draws its media with WebGPU, or with WebGL. Small core, everything else a plugin. No dependencies.",
	"keywords": [
		"slider",
		"carousel",
		"image-slider",
		"gallery",
		"lightbox",
		"webgl",
		"webgl2",
		"webgpu",
		"shader",
		"glsl",
		"transitions",
		"effects",
		"react",
		"nextjs",
		"swiper-alternative"
	],
	"type": "module",
	"license": "MIT",
	"author": "Niklas Jurij Plessing <niklas@eedee.net>",
	"homepage": "https://gpuslider.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/niklasp/gpuslider.git"
	},
	"bugs": "https://github.com/niklasp/gpuslider/issues",
	"sideEffects": [
		"*.css",
		"./lib/auto.js",
		"./dist/auto.js"
	],
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./full": {
			"types": "./types/full.d.ts",
			"default": "./lib/full.js"
		},
		"./canvas": {
			"types": "./types/canvas.d.ts",
			"default": "./lib/canvas.js"
		},
		"./effects": {
			"types": "./types/effects.d.ts",
			"default": "./lib/effects.js"
		},
		"./gpu": {
			"types": "./types/gpu/index.d.ts",
			"default": "./lib/gpu/index.js"
		},
		"./gl": {
			"types": "./types/gl/index.d.ts",
			"default": "./lib/gl/index.js"
		},
		"./lightbox": {
			"types": "./types/lightbox.d.ts",
			"default": "./lib/lightbox.js"
		},
		"./plugins": {
			"types": "./types/plugins/index.d.ts",
			"default": "./lib/plugins/index.js"
		},
		"./react": {
			"types": "./types/react.d.ts",
			"default": "./lib/react.js"
		},
		"./auto": {
			"types": "./types/auto.d.ts",
			"default": "./lib/auto.js"
		},
		"./style.css": "./lib/style.css",
		"./lightbox.css": "./lib/lightbox.css",
		"./loading.css": "./lib/loading.css"
	},
	"files": [
		"lib",
		"types",
		"dist",
		"DOCS.md"
	],
	"scripts": {
		"start": "node bin/serve.mjs",
		"bench": "node bin/bench.mjs",
		"lighthouse": "node bin/lighthouse.mjs",
		"shots": "node bin/make-shots.mjs",
		"phone": "node bin/phone.mjs",
		"site": "npm install --prefix site --no-audit --no-fund && npm run dev --prefix site",
		"build": "node bin/build.mjs",
		"size": "node bin/build.mjs --check",
		"media": "node bin/make-media.mjs && node bin/make-variants.mjs",
		"media:wall": "node bin/make-wall.mjs",
		"media:dream": "node bin/make-dream.mjs",
		"test": "playwright test",
		"check": "tsc -p tsconfig.json --noEmit",
		"types": "rm -rf types && tsc -p tsconfig.json && tsc -p tests/types/tsconfig.json",
		"prepublishOnly": "npm run check && npm run types && npm run size && npm test && npm run test:gpu && npm run test:dist",
		"test:dist": "node bin/build.mjs && FROM=dist playwright test",
		"prepack": "node bin/build.mjs --check && npm run types",
		"test:gpu": "LAYER=gpu playwright test --project=chromium --project=webkit --project=site",
		"release": "node bin/release.mjs patch",
		"release:minor": "node bin/release.mjs minor",
		"release:major": "node bin/release.mjs major"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/react": "^19.3.0",
		"esbuild": "^0.28.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sharp": "^0.35.5",
		"typescript": "^7.0.2"
	},
	"types": "./types/index.d.ts",
	"unpkg": "./dist/auto.js",
	"jsdelivr": "./dist/auto.js",
	"peerDependencies": {
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}
