{
	"compilerOptions": {
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "types",
		"rootDir": "src",
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": [ "es2022", "dom", "dom.iterable" ],
		"skipLibCheck": true
	},
	"include": [ "src/**/*.ts" ]
}
