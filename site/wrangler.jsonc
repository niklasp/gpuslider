// The site on Cloudflare: the files of `dist/` as they are built, at
// gpuslider.com. `npm run build`, then `npx wrangler deploy`.
{
	"name": "gpuslider",
	"compatibility_date": "2026-09-30",
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"routes": [ { "pattern": "gpuslider.com", "custom_domain": true } ]
}
