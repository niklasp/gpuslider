{
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		"lib": [ "ES2022", "DOM", "DOM.Iterable" ],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"checkJs": false,
		"paths": {
			"@/*": [ "./src/*" ],
			"gpuslider": [ "../src/index.ts" ],
			"gpuslider/gl": [ "../src/gl/index.ts" ],
			"gpuslider/gpu": [ "../src/gpu/index.ts" ],
			"gpuslider/canvas": [ "../src/canvas.ts" ],
			"gpuslider/effects": [ "../src/effects.ts" ],
			"gpuslider/lightbox": [ "../src/lightbox.ts" ],
			"gpuslider/plugins": [ "../src/plugins/index.ts" ],
			"gpuslider/auto": [ "../src/auto.ts" ],
			"gpuslider/full": [ "../src/full.ts" ],
			"gpuslider/react": [ "../src/react.ts" ]
		}
	},
	"include": [ "src" ]
}
