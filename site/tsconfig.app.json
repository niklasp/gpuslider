{
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		"lib": [ "ES2022", "DOM", "DOM.Iterable" ],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"allowJs": true,
		"checkJs": false,
		"paths": {
			"@/*": [ "./src/*" ],
			"shaderslide": [ "../src/index.js" ],
			"shaderslide/gl": [ "../src/gl/index.js" ],
			"shaderslide/lightbox": [ "../src/lightbox.js" ],
			"shaderslide/plugins": [ "../src/plugins/index.js" ],
			"shaderslide/full": [ "../src/full.js" ],
			"shaderslide/react": [ "../src/react.js" ]
		}
	},
	"include": [ "src" ]
}
